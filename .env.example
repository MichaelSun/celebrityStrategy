# ==============================================================================
# CelebrityStrategy Environment Configuration Example
# Copy this file to .env and adjust values to match your local setup
# ==============================================================================

# SEC EDGAR requires a specific User-Agent format: "Sample Company Name AdminContact@domain.com"
# See: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=ValueInvestorResearch/1.0 (investor@example.com)

# Optional: Custom path to local cfo-check repository
# If empty, defaults to sibling directory ../cfo-check
# Repo: https://github.com/MichaelSun/cfo-check
CFO_CHECK_PATH=

# Optional: Path to Obsidian Vault for automatic research report synchronization
# Leave blank if you do not use Obsidian
OBSIDIAN_VAULT_PATH=

# Dataroma scraping polite crawl delay in seconds (default: 1.5)
DATAROMA_DELAY_SECONDS=1.5
